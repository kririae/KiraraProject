--- a/src/libtexture/imagecache.cpp
+++ b/src/libtexture/imagecache.cpp
@@ -1070,6 +1070,44 @@ ImageCacheFile::init_from_spec()
 
 
 
+namespace {
+
+bool
+apply_color_transform(ImageCacheImpl& imagecache, const TileID& id, int width,
+                      int height, void* data, TypeDesc format,
+                      stride_t xstride = AutoStride,
+                      stride_t ystride = AutoStride)
+{
+    if (id.colortransformid() <= 0)
+        return true;
+
+    int nchannels = id.chend() - id.chbegin();
+    ImageSpec spec(width, height, nchannels, format);
+    const ImageSpec& file_spec = id.file().spec(id.subimage());
+    for (int channel = 0; channel < nchannels; ++channel)
+        spec.channelnames[channel] = file_spec.channel_name(id.chbegin() + channel);
+    if (file_spec.alpha_channel >= id.chbegin()
+        && file_spec.alpha_channel < id.chend())
+        spec.alpha_channel = file_spec.alpha_channel - id.chbegin();
+    if (file_spec.z_channel >= id.chbegin() && file_spec.z_channel < id.chend())
+        spec.z_channel = file_spec.z_channel - id.chbegin();
+    image_span<std::byte> pixels(static_cast<std::byte*>(data), nchannels, width,
+                                 height, 1, format.size(), xstride, ystride,
+                                 AutoStride, format.size());
+    ImageBuf wrapper(spec, pixels);
+    return ImageBufAlgo::colorconvert(
+        wrapper, wrapper,
+        ColorConfig::default_colorconfig().getColorSpaceNameByIndex(
+            (id.colortransformid() >> 16) - 1),
+        imagecache.colorspace(), !imagecache.unassociatedalpha(), string_view(),
+        string_view(), nullptr,
+        ROI(), 1);
+}
+
+}  // namespace
+
