<scene version="3.0.0">
    <integrator type="path">
        <integer name="max_depth" value="12"/>
        <integer name="rr_depth" value="4"/>
    </integrator>
    <sensor type="perspective">
        <float name="fov" value="35"/>
        <string name="fov_axis" value="y"/>
        <transform name="to_world">
            <lookat origin="0,0.6,5" target="0,0,0" up="0,1,0"/>
        </transform>
        <sampler type="independent">
            <integer name="sample_count" value="256"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width" value="512"/>
            <integer name="height" value="512"/>
            <string name="pixel_format" value="rgb"/>
            <string name="component_format" value="float32"/>
            <rfilter type="box"/>
        </film>
    </sensor>
    <shape type="ply">
        <string name="filename" value="Ground.ply"/>
        <boolean name="face_normals" value="true"/>
        <bsdf type="diffuse"><rgb name="reflectance" value="0.35,0.35,0.35"/></bsdf>
    </shape>
    <shape type="ply">
        <string name="filename" value="Octahedron.ply"/>
        <boolean name="face_normals" value="false"/>
        <bsdf type="principled">
            <rgb name="base_color" value="0.95,0.98,1"/>
            <float name="roughness" value="0.08"/>
            <float name="spec_trans" value="1"/>
            <float name="eta" value="1.5"/>
        </bsdf>
    </shape>
    <shape type="ply">
        <string name="filename" value="Light.ply"/>
        <boolean name="face_normals" value="true"/>
        <bsdf type="diffuse"><rgb name="reflectance" value="0,0,0"/></bsdf>
        <emitter type="area"><rgb name="radiance" value="12,10,8"/></emitter>
    </shape>
</scene>
