<?xml version="1.0"?>
<materialx version="1.39">

  <implementation name="IM_oren_nayar_diffuse_bsdf_genflux" nodedef="ND_oren_nayar_diffuse_bsdf" target="genflux"
                  file="mx-oren-nayar-diffuse-bsdf.slang"
                  sourcecode="makeOrenNayarDiffuseBSDF({{weight}}, {{color}}, {{roughness}}, fluxToShadingFrame(ctx, {{normal}}), {{energy_compensation}})"/>
  <implementation name="IM_burley_diffuse_bsdf_genflux" nodedef="ND_burley_diffuse_bsdf" target="genflux"
                  file="mx-burley-diffuse-bsdf.slang"
                  sourcecode="makeBurleyDiffuseBSDF({{weight}}, {{color}}, {{roughness}}, fluxToShadingFrame(ctx, {{normal}}))"/>
  <implementation name="IM_translucent_bsdf_genflux" nodedef="ND_translucent_bsdf" target="genflux"
                  file="mx-translucent-bsdf.slang"
                  sourcecode="makeTranslucentBSDF({{weight}}, {{color}}, fluxToShadingFrame(ctx, {{normal}}))"/>
  <implementation name="IM_subsurface_bsdf_genflux" nodedef="ND_subsurface_bsdf" target="genflux"
                  file="mx-subsurface-bsdf.slang"
                  sourcecode="makeSubsurfaceBSDF({{weight}}, {{color}}, {{radius}}, fluxToShadingFrame(ctx, {{normal}}))"/>
  <implementation name="IM_conductor_bsdf_genflux" nodedef="ND_conductor_bsdf" target="genflux"
                  file="mx-conductor-bsdf.slang"
                  sourcecode="makeConductorBSDF({{weight}}, {{ior}}, {{extinction}}, {{roughness}}, {{retroreflective}}, {{thinfilm_thickness}}, {{thinfilm_ior}}, fluxToShadingFrame(ctx, {{normal}}), fluxToShadingFrame(ctx, {{tangent}}))"/>
  <implementation name="IM_dielectric_bsdf_genflux" nodedef="ND_dielectric_bsdf" target="genflux"
                  file="mx-dielectric-bsdf.slang"
                  sourcecode="makeDielectricBSDF({{weight}}, {{tint}}, {{ior}}, {{roughness}}, {{retroreflective}}, {{thinfilm_thickness}}, {{thinfilm_ior}}, fluxToShadingFrame(ctx, {{normal}}), fluxToShadingFrame(ctx, {{tangent}}), fluxToShadingFrame(ctx, fluxGetWorldGeometricNormal(ctx)), {{distribution}}, {{scatter_mode}})"/>
  <implementation name="IM_layer_bsdf_genflux" nodedef="ND_layer_bsdf" target="genflux"
                  sourcecode="makeLayerBSDF({{top}}, {{base}})"/>
  <implementation name="IM_multiply_bsdfC_genflux" nodedef="ND_multiply_bsdfC" target="genflux"
                  sourcecode="makeMultiplyBSDF({{in1}}, {{in2}})"/>
  <implementation name="IM_multiply_bsdfF_genflux" nodedef="ND_multiply_bsdfF" target="genflux"
                  sourcecode="makeMultiplyBSDF({{in1}}, {{in2}})"/>
  <implementation name="IM_mix_bsdf_genflux" nodedef="ND_mix_bsdf" target="genflux"
                  sourcecode="makeMixBSDF({{fg}}, {{bg}}, {{mix}})"/>
  <implementation name="IM_surface_genflux" nodedef="ND_surface" target="genflux"
                  sourcecode="{{bsdf}}"/>

  <!-- An EDF emits nothing, and a VDF does nothing. Neither reads an input. -->
  <implementation name="IM_uniform_edf_genflux" nodedef="ND_uniform_edf" target="genflux"
                  sourcecode="0.0"/>
  <implementation name="IM_generalized_schlick_edf_genflux" nodedef="ND_generalized_schlick_edf" target="genflux"
                  sourcecode="0.0"/>
  <implementation name="IM_mix_edf_genflux" nodedef="ND_mix_edf" target="genflux"
                  sourcecode="0.0"/>
  <implementation name="IM_add_edf_genflux" nodedef="ND_add_edf" target="genflux"
                  sourcecode="0.0"/>
  <implementation name="IM_multiply_edfC_genflux" nodedef="ND_multiply_edfC" target="genflux"
                  sourcecode="0.0"/>
  <implementation name="IM_multiply_edfF_genflux" nodedef="ND_multiply_edfF" target="genflux"
                  sourcecode="0.0"/>
  <implementation name="IM_absorption_vdf_genflux" nodedef="ND_absorption_vdf" target="genflux"
                  sourcecode="0.0"/>
  <implementation name="IM_anisotropic_vdf_genflux" nodedef="ND_anisotropic_vdf" target="genflux"
                  sourcecode="0.0"/>
  <!-- A BSDF layered over a VDF is the BSDF. -->
  <implementation name="IM_layer_vdf_genflux" nodedef="ND_layer_vdf" target="genflux"
                  sourcecode="{{top}}"/>

</materialx>
