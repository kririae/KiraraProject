{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "argparse",
    "backward-cpp",
    {
      "name": "embree",
      "default-features": false,
      "features": [
        "geometry-instance",
        "geometry-triangle",
        "tasking-tbb"
      ]
    },
    "eigen3",
    "fmt",
    "gtest",
    "highway",
    "libigl",
    "magic-enum",
    "miniply",
    "openimageio",
    "shader-slang",
    "spdlog",
    "tbb",
    "tomlplusplus"
  ],
  "features": {
    "kirara-dance": {
      "description": "Build kirara-dance",
      "dependencies": [
        "assimp",
        "glfw3",
        "range-v3",
        "tbb",
        "usd"
      ]
    }
  },
  "overrides": [
    {
      "$comment": "Houdini ships oneTBB 2022.1. Code built against newer TBB headers may not run on it.",
      "name": "tbb",
      "version": "2022.1.0"
    }
  ]
}
