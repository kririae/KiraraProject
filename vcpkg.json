{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "backward-cpp",
    "eigen3",
    "fmt",
    "gtest",
    "highway",
    "libigl",
    "magic-enum",
    "spdlog",
    "tomlplusplus"
  ],
  "features": {
    "flux": {
      "description": "Build the FLux renderer",
      "dependencies": [
        "argparse",
        {
          "name": "embree",
          "default-features": false,
          "features": [
            "geometry-instance",
            "geometry-triangle",
            "tasking-tbb"
          ]
        },
        "materialx",
        "miniply",
        "openimageio",
        "shader-slang",
        "tbb"
      ]
    },
    "kirara-dance": {
      "description": "Build kirara-dance",
      "dependencies": [
        "assimp",
        "glfw3",
        "range-v3",
        "shader-slang",
        "tbb",
        "usd"
      ]
    }
  },
  "overrides": [
    {
      "$comment": "Houdini ships oneTBB 2022.1. Code built against newer TBB headers may not run on it.",
      "name": "tbb",
      "version": "2022.1.0"
    }
  ]
}
