{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31
  },
  "configurePresets": [
    {
      "name": "default",
      "description": "Default build using Ninja Multi-Config generator",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "developer",
      "inherits": "default",
      "description": "KIRA developer build using Ninja",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "KRR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "flux",
      "inherits": "developer",
      "description": "FLux developer build",
      "cacheVariables": {
        "KRR_BUILD_FLUX": "ON"
      }
    },
    {
      "name": "kirara-dance",
      "inherits": "developer",
      "description": "Kirara Dance developer build",
      "cacheVariables": {
        "KRR_BUILD_KIRARA_DANCE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "developer",
      "configurePreset": "developer"
    },
    {
      "name": "flux",
      "configurePreset": "flux"
    },
    {
      "name": "kirara-dance",
      "configurePreset": "kirara-dance"
    }
  ]
}
