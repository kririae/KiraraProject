# krr_embed(<target> <variable> OUTPUT <header> FILES <file>... [BASE_DIR <dir>])
#
# Embeds files in <target>, which reads them through <variable> after it includes <header>:
#
#   krr_embed(flux flux::slangModules OUTPUT flux/Optix/OptixSlangModules.inc FILES Optix/flux-context.slang)
#
#   #include "flux/Optix/OptixSlangModules.inc"
#   for (auto const &[path, text] : flux::slangModules)
#
# Each entry pairs the path of a file relative to <dir>, the current source directory by default, with its
# bytes, and each is a std::string_view followed by a null character. A file may be a generator expression,
# such as $<TARGET_OBJECTS:ir>.

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    set(files "")
    set(in_files FALSE)
    math(EXPR last_index "${CMAKE_ARGC} - 1")
    foreach(index RANGE ${last_index})
        if(in_files)
            list(APPEND files "${CMAKE_ARGV${index}}")
        elseif("${CMAKE_ARGV${index}}" STREQUAL "--")
            set(in_files TRUE)
        endif()
    endforeach()

    string(REGEX MATCH "^(.+)::([^:]+)$" qualified "${KRR_EMBED_VARIABLE}")
    set(scope "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")

    cmake_path(SET base_dir NORMALIZE "${KRR_EMBED_BASE_DIR}")
    set(arrays "")
    set(entries "")
    set(index 0)
    foreach(file IN LISTS files)
        cmake_path(ABSOLUTE_PATH file NORMALIZE)
        cmake_path(RELATIVE_PATH file BASE_DIRECTORY "${base_dir}" OUTPUT_VARIABLE path)
        file(READ "${file}" bytes HEX)
        string(REGEX REPLACE "(..)" "'\\\\x\\1'," bytes "${bytes}")
        set(content "${name}Content${index}")
        string(APPEND arrays "inline constexpr char ${content}[] = {${bytes}'\\0'};\n")
        string(APPEND entries "    {\"${path}\", {${content}, sizeof(${content}) - 1}},\n")
        math(EXPR index "${index} + 1")
    endforeach()

    file(
        WRITE "${KRR_EMBED_OUTPUT}"
        "// Generated by krr_embed.\n#pragma once\n\n#include <array>\n#include <string_view>\n#include <utility>\n\n"
        "namespace ${scope} {\n${arrays}\n"
        "inline constexpr std::array<std::pair<std::string_view, std::string_view>, ${index}> ${name}{{\n"
        "${entries}}};\n} // namespace ${scope}\n")
    return()
endif()

function(krr_embed target variable)
    cmake_parse_arguments(PARSE_ARGV 2 EMBED "" "OUTPUT;BASE_DIR" "FILES")
    if(NOT variable MATCHES "^.+::[^:]+$")
        message(FATAL_ERROR "krr_embed: ${variable} is not qualified by a namespace")
    endif()
    if(NOT EMBED_BASE_DIR)
        set(EMBED_BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
    set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/generated")

    add_custom_command(
        OUTPUT "${generated_dir}/${EMBED_OUTPUT}"
        COMMAND
            "${CMAKE_COMMAND}"
              -D "KRR_EMBED_VARIABLE=${variable}"
              -D "KRR_EMBED_OUTPUT=${generated_dir}/${EMBED_OUTPUT}"
              -D "KRR_EMBED_BASE_DIR=${EMBED_BASE_DIR}"
              -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" -- ${EMBED_FILES}
        DEPENDS ${EMBED_FILES} "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
        VERBATIM)
    target_sources(${target} PRIVATE "${generated_dir}/${EMBED_OUTPUT}")
    target_include_directories(${target} PRIVATE "${generated_dir}")
endfunction()
